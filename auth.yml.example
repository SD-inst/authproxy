accounts: "users.txt"
domain: "example.org"
address: "0.0.0.0:8000"
lora_uploads: "/uploads"
push_password: "change-me"
static_path: "static"
cookie_file: "cookie.txt"
sd_timeout: 1800
# Per-user task time limit. A job is aborted (soft interrupt) once its wall-clock
# duration exceeds the limit. Users without an entry use task_timeout_default.
# Keep each limit below sd_timeout so the soft abort fires before the hard
# container restart. Empty/absent = no per-user limit (only sd_timeout applies).
task_timeout:
    alice: "4m"
    bob: "8m"
task_timeout_default: "10m"
task_max_lifetime: "2h"
# Progress bar colors for the /q status page: hex color -> users who queued the
# task (a color may cover several users). The bar gets an animated gradient in
# that color while the user's task runs. Users without an entry (and anonymous
# tasks) keep the default solid blue.
# task_colors:
#     "#ff7a1a": ["alice", "bob"]
#     "#a855f7": ["carol"]
# LLM colors work the same way, but an LLM client authenticates with an API key
# in the Authorization header instead of a site JWT, so there is no username to
# map: the list holds the SHA-256 digests of the keys (64 hex digits, the same
# form LLM_PROXY_VIP_KEYS uses), never the keys themselves. Compute a digest
# with: printf '%s' 'sk-my-key' | sha256sum
# The digest of the header as the client sends it ("Bearer sk-my-key") matches
# too. Keys without an entry keep the default solid blue.
# llm_key_colors:
#     "#22c55e": ["e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"]
#     "#f43f5e": ["2cf24dba5fb0a30e26e83b2ac5b9e29e1b161e5c1fa7425e73043362938b9824"]
# ip_blacklist: client IPs / CIDR ranges to drop at the connection level.
# The IP is read from the proxy headers (X-Forwarded-For / X-Real-IP). A
# matching request has its connection closed with no response sent.
# ip_blacklist:
#   - "203.0.113.7"        # single IP
#   - "198.51.100.0/24"    # CIDR range
acl:
    # The container-control page and its endpoints (/admin) are served to the
    # account named "admin" only, regardless of the ACL; the ACL still has to
    # let that account reach the site ("*" below).
    admin: ["*"]
    alice:
        - a1111
        - status
        - comfyui
        - cozyui
        - "-tts"
        - "-llm"
    carol:
        - acestep
        - status
        - acestep15
    guest:
        - llm
        - acestep
        - acestep15
        - status
